{
  "name": "warframehub",
  "version": "0.1.0",
  "private": true,
  "description": "A personal Warframe companion that runs on your own computer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors yellow,cyan --kill-others-on-fail \"npm run dev -w @warframehub/api\" \"npm run dev -w @warframehub/web\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @warframehub/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "install-launcher": "node scripts/install-launcher.mjs",
    "update-part-recipes": "tsx --conditions=source scripts/update-part-recipes.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
